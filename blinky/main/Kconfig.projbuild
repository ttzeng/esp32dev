menu "Blinky Example Configuration"

    orsource "$IDF_PATH/examples/common_components/env_caps/$IDF_TARGET/Kconfig.env_caps"

    config GPIO_LED
        int "The blinky LED GPIO output pin"
        range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
        default 8
        help
            The GPIO pin numbder assigned to a LED.

    config BLINK_PERIOD
        int "Blink period in msec"
        range 10 3600000
        default 1000
        help
            Define the blinking period in milliseconds.

endmenu

menu "I2C Configuration"

    orsource "$IDF_PATH/examples/common_components/env_caps/$IDF_TARGET/Kconfig.env_caps"

    config GPIO_I2C_SCL
        int "The I2C SCL GPIO output pin"
        range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
        default 9
        help
            The GPIO pin number assigned to the I2C SCL line.

    config GPIO_I2C_SDA
        int "The I2C SDA GPIO output pin"
        range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
        default 8
        help
            The GPIO pin number assigned to the I2C SDA line.

    config I2C_ADDR_LCD
        hex "The I2C address of the LCD"
        default 0x3E
        help
            The I2C address assigned to the LCD display.

    config I2C_ADDR_RGB
        hex "The I2C address of the RGB backlight"
        default 0x62
        help
            The I2C address assigned to the RGB backlight.

endmenu
